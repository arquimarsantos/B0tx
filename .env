# Idiomas disponíveis
# português: 'pt' | espanhol: 'es' | inglês: 'en'
# o idioma será alterado apenas no console
CONSOLE_LANG=pt
# Definindo uma timezone válida a data e horário do bot vai ser alterado de acordo com o local
TIMEZONE=America/Sao_Paulo
# Método de conexão
# QR code: 'qr' | código de emparelhamento: 'pairing'
CONNECTION_METHOD=pairing
# Nome da pasta onde as sessões serão salvas
CREDS_NAME=sessions
# Nome do bot
BOT_NAME=B0tx
# Prefixo dos comandos
PREFIX=!
# 'digitando...' quando o bot estiver respondendo um comando
TYPING=false
# Visualizar as mensagens quando alguém enviar um comando
VIEW_MESSAGES=false
# Conectar as sessões no mongodb
CONNECT_SESSIONS_DB=false
# Conectar todos os bancos de dados no mongodb
CONNECT_DB=true
# Nome do banco de dados no mongodb
MONGO_DB_NAME=bot
# Nome das coleções no mongodb
ANTICOUNTRY=anticountry
ANTILINK=antilink
ANTILINK_WARNINGS=antilink_warnings
ANTIPORN=antiporn
ANTIPORN_WARNINGS=antiporn_warnings
AUTOAPPROVE=autoapprove
BANGHOST=banghost
BANGHOST_ACTIVITY=banghost_activity
LANGUAGE=language
WELCOME=welcome
# Dados da conexão mongodb, se estiver errado o bot irá crashar
MONGO_URI=mongodb://B0tx:vKvKMrCdbekZdJPe@ac-gq8ujs1-shard-00-00.udhc7dj.mongodb.net:27017,ac-gq8ujs1-shard-00-01.udhc7dj.mongodb.net:27017,ac-gq8ujs1-shard-00-02.udhc7dj.mongodb.net:27017/?ssl=true&replicaSet=atlas-4mkn9o-shard-0&authSource=admin&appName=B0tx
# Proxies SOCKS5 aprovados
# 45.61.188.134:44499 (US)
# Ativar depois de conectar o bot pela primeira vez usando "qr" ou "pairing", caso contrário poderão ocorrer problemas de conexão
USE_PROXY=false
PROXY_HOST=45.61.188.134
PROXY_PORT=44499